# Uso local. Preencha em ambiente privado e exporte no shell que inicia o app.
BIOSAUDE_AUTH_MODE=local
BIOSAUDE_OPERATOR_PASSWORD=
BIOSAUDE_ADMIN_PASSWORD=
# O padrão usa data/tuss.sqlite3 e data/audit.sqlite3 sob o projeto.
# BIOSAUDE_TUSS_DB=/caminho/privado/tuss.sqlite3
# BIOSAUDE_AUDIT_DB=/caminho/privado/audit.sqlite3

# Para implantação institucional, configure também .streamlit/secrets.toml.
# BIOSAUDE_AUTH_MODE=oidc
# BIOSAUDE_OPERATOR_SUBJECTS=
# BIOSAUDE_ADMIN_SUBJECTS=
